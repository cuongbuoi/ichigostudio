{
  "name": "ichigo-studio-store",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },
  "vars": {
    "NUXT_PUBLIC_API_BASE": "https://ichigo-studio-api.cuongyo19997.workers.dev"
  },
  "routes": [
    { "pattern": "ichigostudio.vn", "custom_domain": true }
  ]
}
